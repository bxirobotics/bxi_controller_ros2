KERNEL=="ttyUSB*", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE:="0660", SYMLINK+="ttyIMU"
KERNEL=="ttyACM*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", MODE:="0660", SYMLINK+="ttyBAT"
# Yesense USB CDC ACM IMU: VID=5953, PID=5543.  The _1 suffix gives it
# priority 1; an unsuffixed /dev/ttyIMU is reserved for the primary IMU.
KERNEL=="ttyACM*", ATTRS{idVendor}=="5953", ATTRS{idProduct}=="5543", MODE:="0660", SYMLINK+="ttyIMU_YESENSE_1"
ACTION=="add", SUBSYSTEM=="input", KERNEL=="js*", ATTRS{id/vendor}=="20d6", ATTRS{name}=="*Battle Dragon*", ATTRS{capabilities/abs}=="30627", MODE:="0660", RUN+="/usr/local/bin/bxi-battle-dragon-link add %k"
ACTION=="change", SUBSYSTEM=="input", KERNEL=="js*", ATTRS{id/vendor}=="20d6", ATTRS{name}=="*Battle Dragon*", ATTRS{capabilities/abs}=="30627", MODE:="0660", RUN+="/usr/local/bin/bxi-battle-dragon-link add %k"
ACTION=="remove", SUBSYSTEM=="input", KERNEL=="js*", RUN+="/usr/local/bin/bxi-battle-dragon-link remove %k"
