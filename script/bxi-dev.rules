# Hipnuc IMU: it may occupy either USB bus 3, port 8 or port 9.
KERNEL=="ttyUSB*", KERNELS=="3-8", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE:="0660", SYMLINK+="ttyIMU"
KERNEL=="ttyUSB*", KERNELS=="3-9", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", MODE:="0660", SYMLINK+="ttyIMU"
# BMS: other devices may use the same QinHeng VID/PID.  The BMS is always
# connected to USB bus 3, port 8 or port 9, but its order is not fixed.
# Both physical ports therefore map to the same stable alias.
KERNEL=="ttyACM*", KERNELS=="3-8", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", MODE:="0660", SYMLINK+="ttyBAT"
KERNEL=="ttyACM*", KERNELS=="3-9", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", MODE:="0660", SYMLINK+="ttyBAT"
# Yesense USB CDC ACM IMU: it may occupy either USB bus 3, port 8 or port 9.
# The _1 suffix gives it priority 1; an unsuffixed /dev/ttyIMU is reserved
# for the primary IMU.
KERNEL=="ttyACM*", KERNELS=="3-8", ATTRS{idVendor}=="5953", ATTRS{idProduct}=="5543", MODE:="0660", SYMLINK+="ttyIMU_YESENSE_1"
KERNEL=="ttyACM*", KERNELS=="3-9", ATTRS{idVendor}=="5953", ATTRS{idProduct}=="5543", MODE:="0660", SYMLINK+="ttyIMU_YESENSE_1"
ACTION=="add", SUBSYSTEM=="input", KERNEL=="js*", ATTRS{id/vendor}=="20d6", ATTRS{name}=="*Battle Dragon*", ATTRS{capabilities/abs}=="30627", MODE:="0660", RUN+="/usr/local/bin/bxi-battle-dragon-link add %k"
ACTION=="change", SUBSYSTEM=="input", KERNEL=="js*", ATTRS{id/vendor}=="20d6", ATTRS{name}=="*Battle Dragon*", ATTRS{capabilities/abs}=="30627", MODE:="0660", RUN+="/usr/local/bin/bxi-battle-dragon-link add %k"
ACTION=="remove", SUBSYSTEM=="input", KERNEL=="js*", RUN+="/usr/local/bin/bxi-battle-dragon-link remove %k"
